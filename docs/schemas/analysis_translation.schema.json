{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sigy analysis_translation structured output",
  "description": "Stored English translation aligned to an exact transcript revision in the existing CLI snapshot, or an explicit empty projection. Originals and untranslated reasons remain inspectable; a translation is model output, not independent corroboration.",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/snapshot"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "snapshot": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "null"
        },
        "directory_refresh": {
          "type": "null"
        },
        "station_page": {
          "type": "null"
        },
        "ordered_station_page": {
          "type": "null"
        },
        "random_station": {
          "type": "null"
        },
        "directory_catalog": {
          "$ref": "#/$defs/directoryCatalog"
        },
        "linked_station_context": {
          "type": "null"
        },
        "schema_version": {
          "type": "integer",
          "minimum": 0
        },
        "sqlite_version": {
          "type": "string"
        },
        "provider_dispatch_available": {
          "type": "boolean"
        },
        "budgets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/budget"
          }
        },
        "service": {
          "anyOf": [
            {
              "$ref": "#/$defs/service"
            },
            {
              "type": "null"
            }
          ]
        },
        "captures": {
          "$ref": "#/$defs/captures"
        },
        "source_page": {
          "type": "null"
        },
        "recording_page": {
          "type": "null"
        },
        "dvr": {
          "type": "null"
        },
        "recording_metadata": {
          "type": "null"
        },
        "playlist": {
          "type": "null"
        },
        "directory_click": {
          "type": "null"
        },
        "listen": {
          "type": "null"
        },
        "retained": {
          "type": "null"
        },
        "playback": {
          "type": "null"
        },
        "podcast_page": {
          "type": "null"
        },
        "podcast_feed": {
          "type": "null"
        },
        "publisher_text": {
          "type": "null"
        },
        "doctor": {
          "type": "null"
        },
        "schedule": {
          "type": "null"
        },
        "directory_policy": {
          "type": "null"
        },
        "analysis": {
          "type": "null"
        },
        "analysis_job": {
          "type": "null"
        },
        "recognition": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "translation"
                },
                "page": {
                  "$ref": "#/$defs/translationPage"
                }
              },
              "required": [
                "kind",
                "page"
              ],
              "additionalProperties": false
            },
            {
              "$ref": "#/$defs/empty"
            }
          ]
        },
        "provider": {
          "type": "null"
        },
        "monitor": {
          "type": "null"
        },
        "briefing_export": {
          "type": "null"
        },
        "task": {
          "type": "null"
        },
        "claim": {
          "type": "null"
        }
      },
      "required": [
        "directory",
        "directory_refresh",
        "station_page",
        "ordered_station_page",
        "random_station",
        "directory_catalog",
        "linked_station_context",
        "schema_version",
        "sqlite_version",
        "provider_dispatch_available",
        "budgets",
        "service",
        "captures",
        "source_page",
        "recording_page",
        "dvr",
        "recording_metadata",
        "playlist",
        "directory_click",
        "listen",
        "retained",
        "playback",
        "podcast_page",
        "podcast_feed",
        "publisher_text",
        "doctor",
        "schedule",
        "directory_policy",
        "analysis",
        "analysis_job",
        "recognition",
        "provider",
        "monitor",
        "briefing_export",
        "task",
        "claim"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "enum": [
            "failure",
            "usage",
            "service_unavailable",
            "refused",
            "partial",
            "interrupted"
          ]
        },
        "next": {
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false,
      "description": "CLI JSON error envelope. MCP preserves this stderr envelope or synthesizes it for adapter failures; isError is carried outside structuredContent. code and next are present when the command knows them."
    },
    "money": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{6}$",
      "description": "Exact USD decimal string with six fractional digits; never a JSON floating-point amount."
    },
    "budget": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string"
        },
        "limit_usd": {
          "$ref": "#/$defs/money"
        },
        "settled_usd": {
          "$ref": "#/$defs/money"
        },
        "reserved_usd": {
          "$ref": "#/$defs/money"
        },
        "available_usd": {
          "$ref": "#/$defs/money"
        },
        "frozen": {
          "type": "boolean"
        }
      },
      "required": [
        "scope",
        "limit_usd",
        "settled_usd",
        "reserved_usd",
        "available_usd",
        "frozen"
      ],
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "process_id": {
          "type": "integer",
          "minimum": 0
        },
        "uptime_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "stopping": {
          "type": "boolean"
        },
        "maximum_clients": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "process_id",
        "uptime_seconds",
        "stopping",
        "maximum_clients"
      ],
      "additionalProperties": false
    },
    "captures": {
      "type": "object",
      "properties": {
        "dispatch_available": {
          "type": "boolean"
        },
        "scheduled": {
          "type": "integer",
          "minimum": 0
        },
        "active": {
          "type": "integer",
          "minimum": 0
        },
        "interrupted": {
          "type": "integer",
          "minimum": 0
        },
        "terminal": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "dispatch_available",
        "scheduled",
        "active",
        "interrupted",
        "terminal"
      ],
      "additionalProperties": false
    },
    "directoryCatalog": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "comparison": {
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "revision",
        "comparison"
      ],
      "additionalProperties": false
    },
    "empty": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "empty"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "description": "The requested ID has no latest published revision; distinct from a published no-text or legacy revision."
    },
    "translationPage": {
      "type": "object",
      "properties": {
        "transcript_id": {
          "type": "string"
        },
        "transcript_revision": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "job_id": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "profile_sha256": {
          "type": "string"
        },
        "cue_count": {
          "type": "integer",
          "minimum": 0
        },
        "translated_count": {
          "type": "integer",
          "minimum": 0
        },
        "amount_usd": {
          "$ref": "#/$defs/money"
        },
        "created_ms": {
          "type": "integer"
        },
        "pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/translationPair"
          },
          "maxItems": 16
        },
        "next_after_ordinal": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "stale": {
          "const": true,
          "description": "Present only when a newer transcript revision exists. Omitted means this translation follows the newest transcript; it does not promise the newest translation revision."
        }
      },
      "required": [
        "transcript_id",
        "transcript_revision",
        "revision",
        "job_id",
        "profile",
        "profile_sha256",
        "cue_count",
        "translated_count",
        "amount_usd",
        "created_ms",
        "pairs",
        "next_after_ordinal"
      ],
      "additionalProperties": false
    },
    "translationPair": {
      "type": "object",
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "start_us": {
          "type": "integer",
          "minimum": 0
        },
        "end_us": {
          "type": "integer",
          "minimum": 0
        },
        "original": {
          "type": "string",
          "description": "Original script unchanged."
        },
        "state": {
          "type": "string",
          "enum": [
            "translated",
            "untranslated"
          ]
        },
        "english": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ordinal",
        "start_us",
        "end_us",
        "original",
        "state",
        "english",
        "reason"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "state": { "const": "translated" }
        }
      },
      "then": {
        "properties": {
          "english": { "type": "string" },
          "reason": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "english": { "type": "null" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
